class CliError(Exception):
    """Expected command-line/configuration error."""


def project_file_path(name: str) -> Path:
    return Path(__file__).resolve().with_name(name)


def project_dir() -> Path:
    return Path(__file__).resolve().parent


def default_config_path() -> Path:
    return project_file_path("config.json")


def mode_config_path(mode: str) -> Path:
    return project_file_path(f"{mode}.json")


def history_path() -> Path:
    return project_file_path(".alisha_history.json")


def self_help_path() -> Path:
    return project_file_path("README.md")


def local_runtime_config_path() -> Path:
    return project_file_path(LOCAL_RUNTIME_CONFIG)


def read_json_object_file(path: Path, label: str) -> dict[str, Any]:
    if not path.exists():
        return {}

    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except json.JSONDecodeError as exc:
        raise CliError(f"Invalid JSON in {label} {path}: {exc}") from exc
    except OSError as exc:
        raise CliError(f"Unable to read {label} {path}: {exc}") from exc

    if not isinstance(data, dict):
        raise CliError(f"{label.title()} {path} must contain a JSON object.")

    return data


def read_config_file(path: Path) -> dict[str, Any]:
    return read_json_object_file(path, "config")


def read_local_runtime_config() -> dict[str, Any]:
    config = read_json_object_file(local_runtime_config_path(), "local runtime config")

    for name in ("python_interpreter", "system_info", "additional_info"):
        value = config.get(name)
        if value is not None and not isinstance(value, str):
            raise CliError(f"{name} in {LOCAL_RUNTIME_CONFIG} must be a string.")

    return config


def resolve_local_path(path_text: str) -> Path:
    path = Path(path_text).expanduser()
    if not path.is_absolute():
        path = project_dir() / path
    return Path(os.path.abspath(path))


def ensure_configured_interpreter(argv: list[str]) -> dict[str, Any]:
    runtime_config = read_local_runtime_config()
    interpreter_text = runtime_config.get("python_interpreter")
    if not isinstance(interpreter_text, str) or not interpreter_text.strip():
        return runtime_config

    interpreter_path = resolve_local_path(interpreter_text.strip())
    if not interpreter_path.exists():
        raise CliError(f"python_interpreter not found: {interpreter_path}")
    if not interpreter_path.is_file():
        raise CliError(f"python_interpreter is not a file: {interpreter_path}")
    if not os.access(interpreter_path, os.X_OK):
        raise CliError(f"python_interpreter is not executable: {interpreter_path}")

    current_interpreter = Path(os.path.abspath(sys.executable))
    if current_interpreter == interpreter_path:
        os.environ.pop(INTERPRETER_REEXEC_ENV, None)
        return runtime_config

    reexec_target = os.environ.get(INTERPRETER_REEXEC_ENV)
    if reexec_target == str(interpreter_path):
        raise CliError(
            "Configured python_interpreter did not become active after relaunch: "
            f"{interpreter_path} (current interpreter: {current_interpreter})"
        )

    os.environ[INTERPRETER_REEXEC_ENV] = str(interpreter_path)
    try:
        os.execv(
            str(interpreter_path),
            [str(interpreter_path), str(Path(__file__).resolve()), *argv],
        )
    except OSError as exc:
        raise CliError(
            f"Unable to relaunch with python_interpreter {interpreter_path}: {exc}"
        ) from exc

    return runtime_config


def load_config(mode: str, override_path: Optional[Path]) -> dict[str, Any]:
    config = dict(DEFAULT_CONFIG)

    for path in (default_config_path(), mode_config_path(mode)):
        config.update(read_config_file(path))

    if override_path is not None:
        config.update(read_config_file(override_path))

    return config


def apply_local_system_info(
    config: dict[str, Any], runtime_config: dict[str, Any]
) -> dict[str, Any]:
    system_info = runtime_config.get("system_info")
    additional_info = runtime_config.get("additional_info")

    local_lines: list[str] = []
    if isinstance(system_info, str) and system_info.strip():
        local_lines.append(f"System: {system_info.strip()}")
    if isinstance(additional_info, str) and additional_info.strip():
        local_lines.append(f"Additional information: {additional_info.strip()}")

    if not local_lines:
        return config

    system_prompt = config.get("system_prompt")
    if not isinstance(system_prompt, str):
        return config

    config = dict(config)
    local_section = "Local system information:\n" + "\n".join(
        f"- {line}" for line in local_lines
    )
    config["system_prompt"] = f"{system_prompt.rstrip()}\n\n{local_section}".strip()
    return config


def positive_int(value: Any, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise CliError(f"{name} must be a positive integer.")
    return value


def history_count(value: str) -> int:
    try:
        count = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("--history must be an integer.") from exc

    if count < 0 or count > HISTORY_LIMIT:
        raise argparse.ArgumentTypeError(
            f"--history must be between 0 and {HISTORY_LIMIT}."
        )
    return count


def validate_config(config: dict[str, Any]) -> dict[str, Any]:
    config = dict(config)

    if "max_output_tokens" not in config:
        if "max_completion_tokens" in config:
            config["max_output_tokens"] = config["max_completion_tokens"]
        elif "max_tokens" in config:
            config["max_output_tokens"] = config["max_tokens"]

    if not isinstance(config.get("base_url"), str) or not config["base_url"].strip():
        raise CliError("base_url must be a non-empty string.")

    if (
        not isinstance(config.get("api_key_env"), str)
        or not config["api_key_env"].strip()
    ):
        raise CliError("api_key_env must be a non-empty string.")

    if not isinstance(config.get("model"), str) or not config["model"].strip():
        raise CliError("model must be a non-empty string.")

    config["max_output_tokens"] = positive_int(
        config.get("max_output_tokens"), "max_output_tokens"
    )

    max_bytes = config.get("file_context_max_bytes")
    if max_bytes is not None:
        config["file_context_max_bytes"] = positive_int(
            max_bytes, "file_context_max_bytes"
        )

    if not isinstance(config.get("system_prompt"), str):
        raise CliError("system_prompt must be a string.")

    if not isinstance(config.get("stream"), bool):
        raise CliError("stream must be true or false.")

    reasoning_effort = config.get("reasoning_effort")
    if reasoning_effort is not None and reasoning_effort not in REASONING_EFFORTS:
        allowed = ", ".join(REASONING_EFFORTS)
        raise CliError(f"reasoning_effort must be one of: {allowed}.")

    verbosity = config.get("verbosity")
    if verbosity is not None and verbosity not in ("low", "medium", "high"):
        raise CliError("verbosity must be one of: low, medium, high.")

    tools = config.get("tools")
    if tools is not None:
        if not isinstance(tools, list):
            raise CliError("tools must be an array.")
        for tool in tools:
            if not isinstance(tool, dict):
                raise CliError("tools entries must be objects.")
            if tool.get("type") in ("web_search", "web_search_2025_08_26"):
                search_context_size = tool.get("search_context_size")
                if search_context_size is not None and search_context_size not in (
                    "low",
                    "medium",
                    "high",
                ):
                    raise CliError(
                        "web_search search_context_size must be one of: "
                        "low, medium, high."
                    )

    return config


def read_all_stdin() -> str:
    if sys.stdin.isatty():
        return ""
    return sys.stdin.read()


def read_text_file(
    path_text: Union[str, Path], max_bytes: Optional[int]
) -> tuple[str, bool]:
    path = Path(path_text).expanduser()

    if not path.exists():
        raise CliError(f"File not found: {path_text}")
    if not path.is_file():
        raise CliError(f"Not a regular file: {path_text}")

    try:
        with path.open("rb") as handle:
            data = handle.read(max_bytes + 1 if max_bytes is not None else -1)
    except OSError as exc:
        raise CliError(f"Unable to read file {path_text}: {exc}") from exc

    truncated = max_bytes is not None and len(data) > max_bytes
    if truncated:
        data = data[:max_bytes]

    return data.decode("utf-8", errors="replace"), truncated


def build_user_content(
    prompt_parts: list[str],
    file_paths: list[str],
    stdin_text: str,
    include_stdin: bool,
    include_self_help: bool,
    file_context_max_bytes: Optional[int],
) -> str:
    question = " ".join(prompt_parts).strip()
    sections: list[str] = []

    if include_self_help:
        content, truncated = read_text_file(self_help_path(), file_context_max_bytes)
        marker = " truncated" if truncated else ""
        sections.append(
            f"--- alisha self help: README.md{marker} ---\n{content.rstrip()}"
        )

    if question:
        sections.append(f"--- question ---\n{question}")

    for path_text in file_paths:
        content, truncated = read_text_file(path_text, file_context_max_bytes)
        marker = " truncated" if truncated else ""
        sections.append(
            f"--- file: {path_text}{marker} ---\n{content.rstrip()}"
        )

    if include_stdin and stdin_text:
        sections.append(f"--- stdin ---\n{stdin_text.rstrip()}")

    if not question and not include_stdin:
        raise CliError("No prompt provided. Add a question or pipe stdin.")

    if not sections:
        raise CliError("No usable prompt, file context, or stdin content provided.")

    return "\n\n".join(sections).strip()


def load_history(path: Optional[Path] = None) -> list[dict[str, Any]]:
    path = path or history_path()
    if not path.exists():
        return []

    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (json.JSONDecodeError, OSError):
        return []

    if not isinstance(data, list):
        return []

    entries: list[dict[str, Any]] = []
    for item in data:
        if not isinstance(item, dict):
            continue
        question = item.get("question")
        answer = item.get("answer")
        if isinstance(question, str) and isinstance(answer, str):
            entries.append(item)
    return entries[-HISTORY_LIMIT:]


def format_history_context(entries: list[dict[str, Any]], count: int) -> str:
    if count <= 0:
        return ""

    selected = entries[-count:]
    if not selected:
        return ""

    sections = [
        "--- previous alisha exchanges ---",
        (
            "These are prior Alisha question/answer pairs provided only as "
            "additional context."
        ),
    ]

    for index, entry in enumerate(selected, start=1):
        question = entry["question"].strip()
        answer = entry["answer"].strip()
        sections.append(f"[{index}]\nQuestion:\n{question}\n\nAnswer:\n{answer}")

    return "\n\n".join(sections).strip()


def combine_history_and_current(history_context: str, current_content: str) -> str:
    if not history_context:
        return current_content
    return f"{history_context}\n\n--- current request ---\n{current_content}".strip()


def save_history_entry(
    question: str,
    answer: str,
    mode: str,
    model: str,
    self_help: bool,
    path: Optional[Path] = None,
) -> None:
    answer = answer.strip()
    if not answer:
        return

    path = path or history_path()
    entries = load_history(path)
    entries.append(
        {
            "created_at": datetime.now(timezone.utc).isoformat(),
            "question": question,
            "answer": answer,
            "mode": mode,
            "model": model,
            "self_help": self_help,
        }
    )
    entries = entries[-HISTORY_LIMIT:]

    tmp_path = path.with_suffix(path.suffix + ".tmp")
    try:
        with tmp_path.open("w", encoding="utf-8") as handle:
            json.dump(entries, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        tmp_path.replace(path)
    except OSError as exc:
        raise CliError(f"Unable to write history {path}: {exc}") from exc


def response_params(config: dict[str, Any]) -> dict[str, Any]:
    params: dict[str, Any] = {
        "model": config["model"],
        "max_output_tokens": config["max_output_tokens"],
    }

    for name in CONFIGURABLE_RESPONSE_PARAMS:
        if name in config and config[name] is not None:
            params[name] = config[name]

    if config.get("reasoning_effort") is not None:
        params["reasoning"] = {"effort": config["reasoning_effort"]}

    if config.get("verbosity") is not None:
        params["text"] = {"verbosity": config["verbosity"]}

    return params


def load_rich_components() -> dict[str, Any]:
    try:
        from rich.console import Console
        from rich.live import Live
        from rich.markdown import Markdown
        from rich.panel import Panel
        from rich.text import Text
        from rich.theme import Theme
    except ImportError as exc:
        raise CliError(
            "Unable to import the rich package. Install project dependencies in "
            "the configured python_interpreter environment."
        ) from exc

    return {
        "Console": Console,
        "Live": Live,
        "Markdown": Markdown,
        "Panel": Panel,
        "Text": Text,
        "Theme": Theme,
    }


def formatted_console() -> Any:
    rich = load_rich_components()
    return rich["Console"](
        file=sys.stdout,
        force_terminal=True,
        color_system="auto",
        theme=rich["Theme"](FORMAT_THEME_STYLES),
        highlight=True,
    )


def should_use_live_stream(stdout: Any = sys.stdout) -> bool:
    isatty = getattr(stdout, "isatty", None)
    return bool(isatty and isatty())


def default_live_preview_lines() -> int:
    terminal_height = shutil.get_terminal_size(fallback=(80, 24)).lines
    return min(12, max(4, terminal_height // 3))


def wrapped_preview_lines(answer: str, width: int, max_lines: int) -> list[str]:
    if max_lines <= 0:
        return []

    width = max(1, width)
    visual_lines: list[str] = []
    for line in answer.expandtabs(4).splitlines() or [""]:
        if not line:
            visual_lines.append("")
            continue
        visual_lines.extend(
            textwrap.wrap(
                line,
                width=width,
                break_long_words=True,
                break_on_hyphens=False,
                drop_whitespace=False,
                replace_whitespace=False,
            )
            or [""]
        )

    return visual_lines[-max_lines:]


def live_preview_text(answer: str, width: int, max_lines: int) -> Any:
    rich = load_rich_components()
    preview = "\n".join(wrapped_preview_lines(answer or " ", width, max_lines))
    return rich["Text"](preview or " ", overflow="crop")


def blank_live_preview(max_lines: int) -> Any:
    rich = load_rich_components()
    return rich["Text"]("\n".join("" for _ in range(max(1, max_lines))), overflow="crop")


class StreamingAnswerDisplay:
    def __init__(
        self,
        enabled: bool,
        console: Optional[Any] = None,
        max_lines: Optional[int] = None,
    ) -> None:
        self.enabled = enabled
        self.console = console or formatted_console()
        self.answer = ""
        self.live: Optional[Any] = None
        self.max_lines = max_lines or default_live_preview_lines()

    def start(self) -> None:
        if not self.enabled:
            return
        rich = load_rich_components()
        self.live = rich["Live"](
            live_preview_text(self.answer, self.console.width, self.max_lines),
            console=self.console,
            transient=True,
            auto_refresh=False,
            vertical_overflow="crop",
        )
        self.live.start(refresh=True)

    def append(self, delta: str) -> None:
        self.answer += delta
        if self.live is not None:
            self.live.update(
                live_preview_text(self.answer, self.console.width, self.max_lines),
                refresh=True,
            )

    def finish_success(self) -> None:
        if self.live is not None:
            self.live.update(blank_live_preview(self.max_lines), refresh=True)
            self.live.stop()
            self.live = None
        sys.stdout.flush()

    def finish_failure(self) -> None:
        if self.live is not None:
            self.live.update(blank_live_preview(self.max_lines), refresh=True)
            self.live.stop()
            self.live = None
        sys.stdout.flush()


def is_fence_line(line: str) -> bool:
    stripped = line.lstrip()
    return stripped.startswith("```") or stripped.startswith("~~~")


def split_markdown_and_panels(answer: str) -> list[tuple[str, str]]:
    segments: list[tuple[str, str]] = []
    markdown_lines: list[str] = []
    quote_lines: list[str] = []
    in_fence = False

    def flush_markdown() -> None:
        if not markdown_lines:
            return
        markdown = "\n".join(markdown_lines).strip()
        markdown_lines.clear()
        if markdown.strip():
            segments.append(("markdown", markdown))

    def flush_quote() -> None:
        if not quote_lines:
            return
        quote = "\n".join(quote_lines).strip()
        quote_lines.clear()
        if quote:
            segments.append(("panel", quote))

    for line in answer.splitlines():
        if is_fence_line(line):
            flush_quote()
            in_fence = not in_fence
            markdown_lines.append(line)
            continue

        quote_match = None if in_fence else BLOCKQUOTE_RE.match(line)
        if quote_match:
            flush_markdown()
            quote_lines.append(quote_match.group(1))
            continue

        flush_quote()
        markdown_lines.append(line)

    flush_quote()
    flush_markdown()
    return segments


def panel_from_blockquote(content: str) -> Any:
    rich = load_rich_components()
    title = "Quote"
    border_style = "alisha.panel"

    admonition_match = ADMONITION_RE.match(content)
    if admonition_match:
        kind = admonition_match.group(1).lower()
        title = kind.title()
        border_style = f"alisha.panel.{kind}"
        content = content[admonition_match.end() :].lstrip()

    return rich["Panel"](
        rich["Markdown"](content or " ", code_theme="monokai"),
        title=f" {title} ",
        border_style=border_style,
        padding=(0, 1),
    )


def print_formatted_answer(answer: str) -> None:
    if not answer.strip():
        return

    console = formatted_console()
    render_formatted_answer(console, answer)


def render_formatted_answer(console: Any, answer: str) -> None:
    if not answer.strip():
        return

    rich = load_rich_components()
    console.print("\n")
    for kind, content in split_markdown_and_panels(answer):
        if kind == "panel":
            console.print(panel_from_blockquote(content))
        else:
            console.print(rich["Markdown"](content, code_theme="monokai"))
    console.print()


def print_history_answers(entries: list[dict[str, Any]], count: int) -> None:
    selected = entries[-count:] if count > 0 else []
    if not selected:
        print("No saved history yet.")
        return

    rich = load_rich_components()
    console = formatted_console()
    first_number = len(entries) - len(selected) + 1
    for index, entry in enumerate(selected, start=first_number):
        created_at = entry.get("created_at")
        heading = f"Question {index}"
        if isinstance(created_at, str) and created_at:
            heading += f" · {created_at}"
        console.print(rich["Text"](heading, style="bold bright_cyan"))
        console.print(rich["Text"](entry["question"]))
        render_formatted_answer(console, entry["answer"])


def print_non_streamed_response(response: Any) -> str:
    return getattr(response, "output_text", "")


def print_partial_raw_answer(answer: str) -> None:
    if not answer.strip():
        return

    sys.stdout.write("\n--- partial raw answer ---\n")
    sys.stdout.write(answer)
    if not answer.endswith("\n"):
        sys.stdout.write("\n")
    sys.stdout.flush()


def run_portkey_request(config: dict[str, Any], user_content: str) -> tuple[int, str]:
    api_key_env = config["api_key_env"]
    api_key = os.getenv(api_key_env)
    if not api_key:
        print(f"ERROR: {api_key_env} is not set.", file=sys.stderr)
        print(f'Set it with: export {api_key_env}="..."', file=sys.stderr)
        return 2, ""

    try:
        from openai import APIError, APIStatusError, OpenAI
    except ImportError as exc:
        raise CliError(
            "Unable to import the openai package. Set python_interpreter in "
            f"{LOCAL_RUNTIME_CONFIG} to a Python environment with openai installed."
        ) from exc

    client = OpenAI(base_url=config["base_url"], api_key=api_key)
    params = response_params(config)
    params["instructions"] = config["system_prompt"]
    params["input"] = user_content

    answer_parts: list[str] = []
    stream_display: Optional[StreamingAnswerDisplay] = None
    try:
        if config["stream"]:
            stream_display = StreamingAnswerDisplay(should_use_live_stream(sys.stdout))
            stream_display.start()
            stream = client.responses.create(**params, stream=True)
            for event in stream:
                if event.type == "response.output_text.delta":
                    answer_parts.append(event.delta)
                    stream_display.append(event.delta)
                elif event.type == "response.error":
                    stream_display.finish_failure()
                    print_partial_raw_answer("".join(answer_parts))
                    print(f"\n[Portkey error] {event.error}", file=sys.stderr)
                    return 1, ""
            stream_display.finish_success()
        else:
            response = client.responses.create(**params)
            answer_parts.append(print_non_streamed_response(response))
        answer = "".join(answer_parts)
        print_formatted_answer(answer)
        return 0, answer
    except KeyboardInterrupt:
        if stream_display is not None:
            stream_display.finish_failure()
        print_partial_raw_answer("".join(answer_parts))
        return 130, ""
    except APIStatusError as exc:
        if stream_display is not None:
            stream_display.finish_failure()
        print_partial_raw_answer("".join(answer_parts))
        print(
            f"\nERROR: API request failed with status {exc.status_code}: {exc.message}",
            file=sys.stderr,
        )
        return 1, ""
    except APIError as exc:
        if stream_display is not None:
            stream_display.finish_failure()
        print_partial_raw_answer("".join(answer_parts))
        print(f"\nERROR: API request failed: {exc}", file=sys.stderr)
        return 1, ""


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="alisha", add_help=True)
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "--lo",
        action="store_const",
        const="lo",
        dest="mode",
        help="Use the fastest, cheapest mode.",
    )
    mode_group.add_argument(
        "--med",
        action="store_const",
        const="med",
        dest="mode",
        help="Use the balanced mode.",
    )
    mode_group.add_argument(
        "--hi",
        action="store_const",
        const="hi",
        dest="mode",
        help="Use the highest-quality mode.",
    )
    parser.add_argument(
        "prompt",
        nargs="*",
        help="Prompt text. If omitted, stdin can be used as the prompt.",
    )
    parser.add_argument(
        "-f",
        "--file",
        dest="files",
        action="append",
        default=[],
        help="Text file to send as context. May be repeated.",
    )
    parser.add_argument(
        "--stdin",
        action="store_true",
        help="Force reading stdin and append it to the prompt/context.",
    )
    parser.add_argument(
        "-s",
        "--self",
        dest="self_help",
        action="store_true",
        help="Include Alisha's README.md as self-help context.",
    )
    parser.add_argument(
        "--history",
        type=history_count,
        default=0,
        metavar="N",
        help=f"Include the most recent N saved exchanges as context (0-{HISTORY_LIMIT}).",
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=None,
        help="Path to an extra config file loaded after the selected mode.",
    )
    parser.add_argument("--model", help="Override the configured model.")
    parser.add_argument(
        "--reasoning-effort",
        choices=REASONING_EFFORTS,
        help="Override configured reasoning effort.",
    )
    parser.add_argument(
        "--m",
        "--max-output",
        dest="max_output",
        type=int,
        help="Override configured max output tokens.",
    )
    return parser.parse_args(argv)


def main(argv: Optional[list[str]] = None) -> int:
    try:
        raw_argv = argv if argv is not None else sys.argv[1:]
        runtime_config = ensure_configured_interpreter(raw_argv)
        args = parse_args(raw_argv)
        stdin_text = read_all_stdin()
        if (
            args.history > 0
            and not args.prompt
            and not args.files
            and not stdin_text
        ):
            print_history_answers(load_history(), args.history)
            return 0

        mode = args.mode or "lo"
        config = load_config(mode, args.config)
        if args.model:
            config["model"] = args.model
        if args.reasoning_effort:
            config["reasoning_effort"] = args.reasoning_effort
        if args.max_output is not None:
            config["max_output_tokens"] = args.max_output
        config = apply_local_system_info(config, runtime_config)
        config = validate_config(config)

        include_stdin = bool(args.stdin or (not args.prompt and stdin_text))
        user_content = build_user_content(
            prompt_parts=args.prompt,
            file_paths=args.files,
            stdin_text=stdin_text,
            include_stdin=include_stdin,
            include_self_help=False,
            file_context_max_bytes=config["file_context_max_bytes"],
        )
        request_user_content = build_user_content(
            prompt_parts=args.prompt,
            file_paths=args.files,
            stdin_text=stdin_text,
            include_stdin=include_stdin,
            include_self_help=args.self_help,
            file_context_max_bytes=config["file_context_max_bytes"],
        )
        history_context = format_history_context(load_history(), args.history)
        request_content = combine_history_and_current(
            history_context, request_user_content
        )

        status, answer = run_portkey_request(config, request_content)
        if status == 0:
            save_history_entry(
                question=user_content,
                answer=answer,
                mode=mode,
                model=config["model"],
                self_help=args.self_help,
            )
        return status
    except CliError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
